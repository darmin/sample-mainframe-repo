*--- Hidden Fields for Server Communication
*
       05 RSV-USER-ID             PIC X(8)   HIDDEN.
       05 RSV-FUNCTION-CODE       PIC X(2)   HIDDEN.
       05 RSV-CLAIM-KEY           PIC X(12)  HIDDEN.
       05 RSV-TIMESTAMP           PIC X(26)  HIDDEN.
       05 RSV-AUTH-EXCEEDED-FLAG  PIC X(1)   HIDDEN.
       05 RSV-PENDING-APPROVAL    PIC X(1)   HIDDEN.
*
?section LOGIC
*
*================================================================
*  MAIN PROCESSING LOGIC
*================================================================
*
PROCEDURE RSVSCR-MAIN.
*
    PERFORM RSV-INITIALIZE.
    PERFORM RSV-PROCESS UNTIL RSV-FUNCTION-CODE = "EX".
    PERFORM RSV-TERMINATE.
*
END PROCEDURE.
*
*================================================================
*  INITIALIZE SCREEN
*================================================================
*
PROCEDURE RSV-INITIALIZE.
*
    DISPLAY BASE RSV-SCREEN-RECORD.
    MOVE SPACES TO RSV-MESSAGE-AREA.
    MOVE "IN" TO RSV-FUNCTION-CODE.
*
*   Send initial inquiry request to CLMSRV
*
    SEND RSV-SCREEN-RECORD TO CLMSRV
        REPLY LENGTH 2048
        TIMEOUT 30.
*
    IF TERMINATION-STATUS = 0
        RECEIVE RSV-SCREEN-RECORD FROM CLMSRV
        DISPLAY OVERLAY RSV-SCREEN-RECORD
    ELSE
        MOVE "ERROR: Server communication failure - contact support"
            TO RSV-MESSAGE-AREA
        DISPLAY OVERLAY RSV-MESSAGE-AREA
    END-IF.
*
END PROCEDURE.
*
*================================================================
*  MAIN PROCESS LOOP
*================================================================
*
PROCEDURE RSV-PROCESS.
*
    ACCEPT RSV-SCREEN-RECORD UNTIL
        F3-KEY, F5-KEY, F7-KEY, F8-KEY.
*
    EVALUATE TRUE
        WHEN F3-KEY
            MOVE "EX" TO RSV-FUNCTION-CODE
*
        WHEN F5-KEY
            PERFORM RSV-VALIDATE-CHANGES
            IF RSV-MESSAGE-AREA = SPACES
                PERFORM RSV-SAVE-RESERVES
            END-IF
*
        WHEN F7-KEY
            MOVE "HI" TO RSV-FUNCTION-CODE
            PERFORM RSV-REQUEST-HISTORY
*
        WHEN F8-KEY
            IF RSV-PENDING-APPROVAL = "Y"
                MOVE "AP" TO RSV-FUNCTION-CODE
                PERFORM RSV-APPROVE-RESERVES
            ELSE
                MOVE "No pending reserve changes to approve"
                    TO RSV-MESSAGE-AREA
                DISPLAY OVERLAY RSV-MESSAGE-AREA
            END-IF
*
    END-EVALUATE.
*
END PROCEDURE.
*
*================================================================
*  VALIDATE RESERVE CHANGES
*================================================================
*
PROCEDURE RSV-VALIDATE-CHANGES.
*
    MOVE SPACES TO RSV-MESSAGE-AREA.
    MOVE "N" TO RSV-AUTH-EXCEEDED-FLAG.
*
*   Check that at least one change amount is non-zero
*
    IF RSV-CAT1-CHANGE = ZERO AND RSV-CAT2-CHANGE = ZERO
       AND RSV-CAT3-CHANGE = ZERO AND RSV-CAT4-CHANGE = ZERO
       AND RSV-CAT5-CHANGE = ZERO AND RSV-CAT6-CHANGE = ZERO
       AND RSV-CAT7-CHANGE = ZERO AND RSV-CAT8-CHANGE = ZERO
        MOVE "No reserve changes entered" TO RSV-MESSAGE-AREA
        DISPLAY OVERLAY RSV-MESSAGE-AREA
    END-IF.
*
*   Require reason code for any change
*
    IF RSV-MESSAGE-AREA = SPACES
        IF RSV-REASON-CODE = SPACES
            MOVE "Reason code required for reserve changes"
                TO RSV-MESSAGE-AREA
            DISPLAY OVERLAY RSV-MESSAGE-AREA
        END-IF
    END-IF.
*
*   Require narrative for changes exceeding $10,000
*
    IF RSV-MESSAGE-AREA = SPACES
        IF RSV-CAT1-CHANGE > 10000 OR RSV-CAT2-CHANGE > 10000
           OR RSV-CAT3-CHANGE > 10000 OR RSV-CAT4-CHANGE > 10000
           OR RSV-CAT5-CHANGE > 10000 OR RSV-CAT6-CHANGE > 10000
           OR RSV-CAT7-CHANGE > 10000 OR RSV-CAT8-CHANGE > 10000
            IF RSV-NARRATIVE-L1 = SPACES
                MOVE "Narrative required for changes > $10,000"
                    TO RSV-MESSAGE-AREA
                DISPLAY OVERLAY RSV-MESSAGE-AREA
            END-IF
        END-IF
    END-IF.
*
*   Validate reason code exists (server-side validation)
*
    IF RSV-MESSAGE-AREA = SPACES
        MOVE "VL" TO RSV-FUNCTION-CODE
        SEND RSV-SCREEN-RECORD TO CLMSRV
            REPLY LENGTH 2048
            TIMEOUT 15
        RECEIVE RSV-SCREEN-RECORD FROM CLMSRV
        IF RSV-AUTH-EXCEEDED-FLAG = "Y"
            MOVE "YES" TO RSV-APPROVAL-REQUIRED
            MOVE "Authority exceeded - supervisor approval required"
                TO RSV-MESSAGE-AREA
            DISPLAY OVERLAY RSV-APPROVAL-REQUIRED
            DISPLAY OVERLAY RSV-MESSAGE-AREA
        END-IF
    END-IF.
*
END PROCEDURE.
*
*================================================================
*  SAVE RESERVE CHANGES
*================================================================
*
PROCEDURE RSV-SAVE-RESERVES.
*
    MOVE "SV" TO RSV-FUNCTION-CODE.
*
    SEND RSV-SCREEN-RECORD TO CLMSRV
        REPLY LENGTH 2048
        TIMEOUT 30.
*
    IF TERMINATION-STATUS = 0
        RECEIVE RSV-SCREEN-RECORD FROM CLMSRV
        DISPLAY OVERLAY RSV-SCREEN-RECORD
        IF RSV-AUTH-EXCEEDED-FLAG = "Y"
            MOVE "Reserve change saved - PENDING APPROVAL"
                TO RSV-MESSAGE-AREA
            MOVE "Y" TO RSV-PENDING-APPROVAL
        ELSE
            MOVE "Reserve change saved successfully"
                TO RSV-MESSAGE-AREA
        END-IF
    ELSE
        MOVE "ERROR: Save failed - reserve record may be locked"
            TO RSV-MESSAGE-AREA
    END-IF.
*
    DISPLAY OVERLAY RSV-MESSAGE-AREA.
*
END PROCEDURE.
*
*================================================================
*  REQUEST RESERVE HISTORY
*================================================================
*
PROCEDURE RSV-REQUEST-HISTORY.
*
    SEND RSV-SCREEN-RECORD TO CLMSRV
        REPLY LENGTH 2048
        TIMEOUT 15.
*
    IF TERMINATION-STATUS = 0
        RECEIVE RSV-SCREEN-RECORD FROM CLMSRV
        ESCAPE TO RSVHIST
    ELSE
        MOVE "ERROR: Unable to retrieve reserve history"
            TO RSV-MESSAGE-AREA
        DISPLAY OVERLAY RSV-MESSAGE-AREA
    END-IF.
*
END PROCEDURE.
*
*================================================================
*  APPROVE PENDING RESERVE CHANGES
*================================================================
*
PROCEDURE RSV-APPROVE-RESERVES.
*
    SEND RSV-SCREEN-RECORD TO CLMSRV
        REPLY LENGTH 2048
        TIMEOUT 30.
*
    IF TERMINATION-STATUS = 0
        RECEIVE RSV-SCREEN-RECORD FROM CLMSRV
        DISPLAY OVERLAY RSV-SCREEN-RECORD
        MOVE "N" TO RSV-PENDING-APPROVAL
        MOVE "   " TO RSV-APPROVAL-REQUIRED
        MOVE "Reserve change approved and applied"
            TO RSV-MESSAGE-AREA
    ELSE
        MOVE "ERROR: Approval failed - insufficient authority"
            TO RSV-MESSAGE-AREA
    END-IF.
*
    DISPLAY OVERLAY RSV-MESSAGE-AREA.
    DISPLAY OVERLAY RSV-APPROVAL-REQUIRED.
*
END PROCEDURE.
*
*================================================================
*  TERMINATE SCREEN
*================================================================
*
PROCEDURE RSV-TERMINATE.
*
    ESCAPE TO CLMMENU.
*
END PROCEDURE.
