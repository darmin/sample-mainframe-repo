?page "WCBENSCR - Benefits Calculation Screen"
?section IDENTIFICATION
*
*  SCREEN NAME:   WCBENSCR
*  DESCRIPTION:   Workers' Compensation Benefits Calculation Screen
*  SYSTEM:        Claims Management System (CMS)
*  PATHWAY:       BENSRV (Benefits Calculation Server Class)
*  AUTHOR:        TPA Systems Development
*  DATE:          2024-07-01
*  MODIFIED:      2025-01-10 - Added multi-jurisdiction rate tables
*
*  This screen calculates indemnity benefits based on jurisdiction-
*  specific rules. Each state has unique AWW limits, compensation
*  rates, waiting periods, and duration caps. The calculation engine
*  supports TTD, TPD, PPD, PTD, and Death benefits.
*
*  Jurisdiction rules are maintained in the JURISRUL Enscribe file
*  indexed by state code and date of injury. Rate changes are
*  effective by DOI, not by payment date.
*
?section DATA
*
*    Copybook references
           COPY WCCLMCPY
*
SCREEN WCBENSCR.
*
    01 BEN-SCREEN-RECORD.
*
*--- Claim/Claimant Header (Lines 1-3)
*
       05 BEN-HDR-CLAIM-NBR       PIC X(12)
           AT 1, 2
           DISPLAY LENGTH 12
           PROTECTED
           VALUE SPACES.
       05 BEN-HDR-CLAIMANT-NAME   PIC X(30)
           AT 1, 16
           DISPLAY LENGTH 30
           PROTECTED
           VALUE SPACES.
       05 BEN-HDR-DOI             PIC X(10)
           AT 1, 50
           DISPLAY LENGTH 10
           PROTECTED
           VALUE SPACES.
       05 BEN-HDR-JURISDICTION    PIC X(2)
           AT 1, 64
           DISPLAY LENGTH 2
           PROTECTED
           VALUE SPACES.
       05 BEN-HDR-EMPLOYER-NAME   PIC X(30)
           AT 2, 16
           DISPLAY LENGTH 30
           PROTECTED.
       05 BEN-HDR-SSN-LAST4       PIC X(4)
           AT 2, 50
           DISPLAY LENGTH 4
           PROTECTED.
       05 BEN-HDR-CLAIM-TYPE      PIC X(12)
           AT 2, 58
           DISPLAY LENGTH 12
           PROTECTED.
       05 BEN-HDR-INJURY-DESC     PIC X(40)
           AT 3, 16
           DISPLAY LENGTH 40
           PROTECTED.
       05 BEN-HDR-BODY-PART       PIC X(20)
           AT 3, 58
           DISPLAY LENGTH 20
           PROTECTED.
*
*--- Wage Information (Lines 5-7)
*
       05 BEN-WAGE-LABEL          PIC X(20)
           AT 5, 1
           DISPLAY LENGTH 20
           PROTECTED
           VALUE "Wage Information:   ".
       05 BEN-AWW-AMOUNT          PIC $Z,ZZZ.99
           AT 5, 22
           DISPLAY LENGTH 10.
       05 BEN-AWW-LABEL           PIC X(18)
           AT 5, 34
           DISPLAY LENGTH 18
           PROTECTED
           VALUE "Average Wkly Wage ".
       05 BEN-WEEKLY-RATE         PIC $Z,ZZZ.99
           AT 6, 22
           DISPLAY LENGTH 10
           PROTECTED.
       05 BEN-RATE-LABEL          PIC X(18)
           AT 6, 34
           DISPLAY LENGTH 18
           PROTECTED
           VALUE "Weekly Comp Rate  ".
       05 BEN-RATE-PERCENT        PIC ZZ9.99
           AT 6, 54
           DISPLAY LENGTH 6
           PROTECTED.
       05 BEN-RATE-PCT-LABEL      PIC X(1)
           AT 6, 61
           DISPLAY LENGTH 1
           PROTECTED
           VALUE "%".
*
       05 BEN-MAX-RATE            PIC $Z,ZZZ.99
           AT 7, 22
           DISPLAY LENGTH 10
           PROTECTED.
       05 BEN-MAX-RATE-LABEL      PIC X(20)
           AT 7, 34
           DISPLAY LENGTH 20
           PROTECTED
           VALUE "State Max Rate (DOI)".
       05 BEN-MIN-RATE            PIC $Z,ZZZ.99
           AT 7, 58
           DISPLAY LENGTH 10
           PROTECTED.
       05 BEN-MIN-RATE-LABEL      PIC X(8)
           AT 7, 70
           DISPLAY LENGTH 8
           PROTECTED
           VALUE "State Min".
*
*--- Benefit Type Selection (Line 9)
*
       05 BEN-TYPE-CODE           PIC X(3)
           AT 9, 22
           DISPLAY LENGTH 3
           UPSHIFT.
       05 BEN-TYPE-DESC           PIC X(30)
           AT 9, 28
           DISPLAY LENGTH 30
           PROTECTED.
       05 BEN-TYPE-HELP           PIC X(40)
           AT 9, 35
           DISPLAY LENGTH 40
           PROTECTED
           VALUE "(TTD TPD PPD PTD DTH)".
*
*--- Calculation Details (Lines 10-14)
*
       05 BEN-START-DATE          PIC X(10)
           AT 10, 22
           DISPLAY LENGTH 10.
       05 BEN-START-LABEL         PIC X(18)
           AT 10, 34
           DISPLAY LENGTH 18
           PROTECTED
           VALUE "Disability Start  ".
       05 BEN-END-DATE            PIC X(10)
           AT 11, 22
           DISPLAY LENGTH 10.
       05 BEN-END-LABEL           PIC X(18)
           AT 11, 34
           DISPLAY LENGTH 18
           PROTECTED
           VALUE "Disability End    ".
       05 BEN-TOTAL-DAYS          PIC ZZZ,ZZ9
           AT 11, 56
           DISPLAY LENGTH 7
           PROTECTED.
       05 BEN-DAYS-LABEL          PIC X(10)
           AT 11, 65
           DISPLAY LENGTH 10
           PROTECTED
           VALUE "Total Days".
*
       05 BEN-WAIT-DAYS           PIC ZZ9
           AT 12, 22
           DISPLAY LENGTH 3
           PROTECTED.
       05 BEN-WAIT-LABEL          PIC X(24)
           AT 12, 28
           DISPLAY LENGTH 24
           PROTECTED
           VALUE "Waiting Period (days)   ".
       05 BEN-WAIT-SATISFIED      PIC X(3)
           AT 12, 54
           DISPLAY LENGTH 3
           PROTECTED.
       05 BEN-RETRO-DAYS          PIC ZZ9
           AT 13, 22
           DISPLAY LENGTH 3
           PROTECTED.
       05 BEN-RETRO-LABEL         PIC X(26)
           AT 13, 28
           DISPLAY LENGTH 26
           PROTECTED
           VALUE "Retroactive Period (days) ".
       05 BEN-RETRO-APPLIES       PIC X(3)
           AT 13, 56
           DISPLAY LENGTH 3
           PROTECTED.
*
       05 BEN-DURATION-MAX        PIC ZZZ,ZZ9
           AT 14, 22
           DISPLAY LENGTH 7
           PROTECTED.
       05 BEN-DURATION-LABEL      PIC X(28)
           AT 14, 32
           DISPLAY LENGTH 28
           PROTECTED
           VALUE "Max Duration (weeks) per Jur".
       05 BEN-DURATION-REMAINING  PIC ZZZ,ZZ9
           AT 14, 64
           DISPLAY LENGTH 7
           PROTECTED.
       05 BEN-DUR-REM-LABEL       PIC X(5)
           AT 14, 73
           DISPLAY LENGTH 5
           PROTECTED
           VALUE "Rem'd".
*
*--- Payment Schedule Preview (Lines 16-20)
*
       05 BEN-SCHED-HEADER        PIC X(78)
           AT 16, 1
           DISPLAY LENGTH 78
           PROTECTED
           VALUE "  # Period Start  Period End    "
           &     "Gross Amt   Deductions  Net Amount".
*
       05 BEN-SCHED OCCURS 4 TIMES.
          10 BEN-SCHED-NBR        PIC ZZ9
              DISPLAY LENGTH 3
              PROTECTED.
          10 BEN-SCHED-FROM       PIC X(10)
              DISPLAY LENGTH 10
              PROTECTED.
          10 BEN-SCHED-TO         PIC X(10)
              DISPLAY LENGTH 10
              PROTECTED.
          10 BEN-SCHED-GROSS      PIC $Z,ZZZ.99
              DISPLAY LENGTH 10
              PROTECTED.
          10 BEN-SCHED-DEDUCT     PIC $Z,ZZZ.99
              DISPLAY LENGTH 10
              PROTECTED.
          10 BEN-SCHED-NET        PIC $Z,ZZZ.99
              DISPLAY LENGTH 10
              PROTECTED.
*
*--- Jurisdiction Rule Display (Line 21)
*
       05 BEN-JURIS-RULE-DESC     PIC X(78)
           AT 21, 1
           DISPLAY LENGTH 78
           PROTECTED.
*
