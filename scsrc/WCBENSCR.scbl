       05 BEN-OVERRIDE-APPROVED   PIC X(8)
           AT 22, 52
           DISPLAY LENGTH 8
           PROTECTED.
       05 BEN-OVERRIDE-BY         PIC X(8)
           AT 22, 62
           DISPLAY LENGTH 8
           PROTECTED.
*
*--- Message and Function Key Area (Lines 23-24)
*
       05 BEN-MESSAGE-AREA        PIC X(78)
           AT 23, 1
           DISPLAY LENGTH 78
           PROTECTED.
       05 BEN-FKEY-LINE           PIC X(78)
           AT 24, 1
           DISPLAY LENGTH 78
           PROTECTED
           VALUE "F3=Exit  F5=Calculate  F7=Wage Detail"
           &     "  F9=Schedule                       ".
*
*--- Hidden Fields
*
       05 BEN-USER-ID             PIC X(8)   HIDDEN.
       05 BEN-FUNCTION-CODE       PIC X(2)   HIDDEN.
       05 BEN-CLAIM-KEY           PIC X(12)  HIDDEN.
       05 BEN-TIMESTAMP           PIC X(26)  HIDDEN.
       05 BEN-CALC-STATUS         PIC X(2)   HIDDEN.
       05 BEN-OVERRIDE-PENDING    PIC X(1)   HIDDEN.
       05 BEN-JURIS-RULE-KEY      PIC X(10)  HIDDEN.
       05 BEN-PREV-TTD-WEEKS      PIC 9(5)   HIDDEN.
       05 BEN-PREV-TPD-WEEKS      PIC 9(5)   HIDDEN.
       05 BEN-PREV-PPD-WEEKS      PIC 9(5)   HIDDEN.
*
?section LOGIC
*
*    Server communication via PATHSEND
           PATHSEND USING "WCBENCALC"
           PATHSEND USING "WCJURIS"
*
*================================================================
*  MAIN PROCESSING LOGIC
*================================================================
*
PROCEDURE WCBENSCR-MAIN.
*
    PERFORM BEN-INITIALIZE.
    PERFORM BEN-PROCESS UNTIL BEN-FUNCTION-CODE = "EX".
    PERFORM BEN-TERMINATE.
*
END PROCEDURE.
*
*================================================================
*  INITIALIZE SCREEN
*================================================================
*
PROCEDURE BEN-INITIALIZE.
*
    DISPLAY BASE BEN-SCREEN-RECORD.
    MOVE SPACES TO BEN-MESSAGE-AREA.
    MOVE "IN" TO BEN-FUNCTION-CODE.
*
*   Load claim header, wage data, jurisdiction rules
*
    SEND BEN-SCREEN-RECORD TO BENSRV
        REPLY LENGTH 4096
        TIMEOUT 30.
*
    IF TERMINATION-STATUS = 0
        RECEIVE BEN-SCREEN-RECORD FROM BENSRV
        DISPLAY OVERLAY BEN-SCREEN-RECORD
*
*       Display jurisdiction-specific info
*
        EVALUATE BEN-HDR-JURISDICTION
            WHEN "CA"
                MOVE "CA: 2/3 AWW, $290.00 min, $1,619.15 max (2024)"
                    TO BEN-JURIS-RULE-DESC
            WHEN "TX"
                MOVE "TX: 70% AWW, $183.00 min, $1,111.00 max (2024)"
                    TO BEN-JURIS-RULE-DESC
            WHEN "FL"
                MOVE "FL: 66.67% AWW, $20.00 min, $1,197.00 max (2024)"
                    TO BEN-JURIS-RULE-DESC
            WHEN "NY"
                MOVE "NY: 66.67% AWW, $150.00 min, $1,145.43 max (2024)"
                    TO BEN-JURIS-RULE-DESC
            WHEN OTHER
                MOVE "Jurisdiction rules loaded from JURISRUL file"
                    TO BEN-JURIS-RULE-DESC
        END-EVALUATE
        DISPLAY OVERLAY BEN-JURIS-RULE-DESC
    ELSE
        MOVE "ERROR: Benefits server unavailable"
            TO BEN-MESSAGE-AREA
        DISPLAY OVERLAY BEN-MESSAGE-AREA
    END-IF.
*
END PROCEDURE.
*
*================================================================
*  MAIN PROCESS LOOP
*================================================================
*
PROCEDURE BEN-PROCESS.
*
    ACCEPT BEN-SCREEN-RECORD UNTIL
        F3-KEY, F5-KEY, F7-KEY, F9-KEY.
*
    EVALUATE TRUE
        WHEN F3-KEY
            MOVE "EX" TO BEN-FUNCTION-CODE
*
        WHEN F5-KEY
            PERFORM BEN-VALIDATE-INPUT
            IF BEN-MESSAGE-AREA = SPACES
                PERFORM BEN-CALCULATE
            END-IF
*
        WHEN F7-KEY
            MOVE "WG" TO BEN-FUNCTION-CODE
            SEND BEN-SCREEN-RECORD TO BENSRV
                REPLY LENGTH 4096
                TIMEOUT 15
            IF TERMINATION-STATUS = 0
                RECEIVE BEN-SCREEN-RECORD FROM BENSRV
                ESCAPE TO WAGESCR
            END-IF
*
        WHEN F9-KEY
            IF BEN-CALC-STATUS = "OK"
                MOVE "SC" TO BEN-FUNCTION-CODE
                SEND BEN-SCREEN-RECORD TO BENSRV
                    REPLY LENGTH 4096
                    TIMEOUT 15
                IF TERMINATION-STATUS = 0
                    RECEIVE BEN-SCREEN-RECORD FROM BENSRV
                    ESCAPE TO SCHEDSCR
                END-IF
            ELSE
                MOVE "Calculate benefits first (F5) before schedule"
                    TO BEN-MESSAGE-AREA
                DISPLAY OVERLAY BEN-MESSAGE-AREA
            END-IF
*
    END-EVALUATE.
*
END PROCEDURE.
*
*================================================================
*  VALIDATE CALCULATION INPUT
*================================================================
*
PROCEDURE BEN-VALIDATE-INPUT.
*
    MOVE SPACES TO BEN-MESSAGE-AREA.
*
*   Validate AWW
*
    IF BEN-AWW-AMOUNT = ZERO OR BEN-AWW-AMOUNT < 0
        MOVE "Average Weekly Wage is required and must be positive"
            TO BEN-MESSAGE-AREA
        DISPLAY OVERLAY BEN-MESSAGE-AREA
    END-IF.
*
*   Validate benefit type
*
    IF BEN-MESSAGE-AREA = SPACES
        IF BEN-TYPE-CODE NOT = "TTD" AND BEN-TYPE-CODE NOT = "TPD"
           AND BEN-TYPE-CODE NOT = "PPD" AND BEN-TYPE-CODE NOT = "PTD"
           AND BEN-TYPE-CODE NOT = "DTH"
            MOVE "Invalid benefit type - use TTD, TPD, PPD, PTD, DTH"
                TO BEN-MESSAGE-AREA
            DISPLAY OVERLAY BEN-MESSAGE-AREA
        END-IF
    END-IF.
*
*   Validate dates
*
    IF BEN-MESSAGE-AREA = SPACES
        IF BEN-START-DATE = SPACES
            MOVE "Disability start date is required"
                TO BEN-MESSAGE-AREA
            DISPLAY OVERLAY BEN-MESSAGE-AREA
        END-IF
    END-IF.
*
*   Validate PPD specifics (impairment rating needed)
*
    IF BEN-MESSAGE-AREA = SPACES
        IF BEN-TYPE-CODE = "PPD"
            IF BEN-END-DATE = SPACES
                MOVE "End date required for PPD (based on rating)"
                    TO BEN-MESSAGE-AREA
                DISPLAY OVERLAY BEN-MESSAGE-AREA
            END-IF
        END-IF
    END-IF.
*
*   Check for override requiring supervisor approval
*
    IF BEN-MESSAGE-AREA = SPACES
        IF BEN-OVERRIDE-RATE > ZERO
            IF BEN-OVERRIDE-APPROVED = SPACES
                MOVE "Rate override requires supervisor approval"
                    TO BEN-MESSAGE-AREA
                MOVE "Y" TO BEN-OVERRIDE-PENDING
                DISPLAY OVERLAY BEN-MESSAGE-AREA
            END-IF
        END-IF
    END-IF.
*
END PROCEDURE.
*
*================================================================
*  CALCULATE BENEFITS
*================================================================
*
PROCEDURE BEN-CALCULATE.
*
    MOVE "CL" TO BEN-FUNCTION-CODE.
*
    SEND BEN-SCREEN-RECORD TO BENSRV
        REPLY LENGTH 4096
        TIMEOUT 30.
*
    IF TERMINATION-STATUS = 0
        RECEIVE BEN-SCREEN-RECORD FROM BENSRV
        DISPLAY OVERLAY BEN-SCREEN-RECORD
*
        EVALUATE BEN-CALC-STATUS
            WHEN "OK"
                MOVE "Calculation complete - review schedule below"
                    TO BEN-MESSAGE-AREA
            WHEN "WN"
                MOVE "Calculated with warnings - check jurisdiction rules"
                    TO BEN-MESSAGE-AREA
            WHEN "MX"
                MOVE "Rate capped at state maximum for DOI"
                    TO BEN-MESSAGE-AREA
            WHEN "MN"
                MOVE "Rate set to state minimum"
                    TO BEN-MESSAGE-AREA
            WHEN "DX"
                MOVE "Duration limit reached for this benefit type"
                    TO BEN-MESSAGE-AREA
            WHEN OTHER
                MOVE "Calculation error - contact support"
                    TO BEN-MESSAGE-AREA
        END-EVALUATE
    ELSE
        MOVE "ERROR: Calculation server timeout"
            TO BEN-MESSAGE-AREA
    END-IF.
*
    DISPLAY OVERLAY BEN-MESSAGE-AREA.
*
END PROCEDURE.
*
*================================================================
*  TERMINATE SCREEN
*================================================================
*
PROCEDURE BEN-TERMINATE.
*
    ESCAPE TO CLMMENU.
*
END PROCEDURE.
