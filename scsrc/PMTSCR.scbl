           AT 21, 72
           DISPLAY LENGTH 1
           UPSHIFT.
*
*--- Message and Function Key Area (Lines 23-24)
*
       05 PMT-MESSAGE-AREA        PIC X(78)
           AT 23, 1
           DISPLAY LENGTH 78
           PROTECTED.
       05 PMT-FKEY-LINE           PIC X(78)
           AT 24, 1
           DISPLAY LENGTH 78
           PROTECTED
           VALUE "F2=Payee Lkup  F3=Exit  F5=Submit  "
           &     "F7=Fee Sched  F9=History".
*
*--- Hidden Fields
*
       05 PMT-USER-ID             PIC X(8)   HIDDEN.
       05 PMT-FUNCTION-CODE       PIC X(2)   HIDDEN.
       05 PMT-CLAIM-KEY           PIC X(12)  HIDDEN.
       05 PMT-PAYMENT-KEY         PIC X(15)  HIDDEN.
       05 PMT-TIMESTAMP           PIC X(26)  HIDDEN.
       05 PMT-DUP-CHECK-FLAG      PIC X(1)   HIDDEN.
       05 PMT-1099-REPORTABLE     PIC X(1)   HIDDEN.
       05 PMT-LIEN-HOLD-FLAG      PIC X(1)   HIDDEN.
       05 PMT-RESERVE-ADEQUATE    PIC X(1)   HIDDEN.
*
?section LOGIC
*
*    Server communication via PATHSEND
           PATHSEND USING "PMTPROC"
           PATHSEND USING "PMTAPPR"
*
*================================================================
*  MAIN PROCESSING LOGIC
*================================================================
*
PROCEDURE PMTSCR-MAIN.
*
    PERFORM PMT-INITIALIZE.
    PERFORM PMT-PROCESS UNTIL PMT-FUNCTION-CODE = "EX".
    PERFORM PMT-TERMINATE.
*
END PROCEDURE.
*
*================================================================
*  INITIALIZE SCREEN
*================================================================
*
PROCEDURE PMT-INITIALIZE.
*
    DISPLAY BASE PMT-SCREEN-RECORD.
    MOVE SPACES TO PMT-MESSAGE-AREA.
    MOVE SPACES TO PMT-DUP-WARNING.
    MOVE "IN" TO PMT-FUNCTION-CODE.
*
    SEND PMT-SCREEN-RECORD TO PMTSRV
        REPLY LENGTH 4096
        TIMEOUT 30.
*
    IF TERMINATION-STATUS = 0
        RECEIVE PMT-SCREEN-RECORD FROM PMTSRV
        DISPLAY OVERLAY PMT-SCREEN-RECORD
    ELSE
        MOVE "ERROR: Payment server unavailable" TO PMT-MESSAGE-AREA
        DISPLAY OVERLAY PMT-MESSAGE-AREA
    END-IF.
*
END PROCEDURE.
*
*================================================================
*  MAIN PROCESS LOOP
*================================================================
*
PROCEDURE PMT-PROCESS.
*
    ACCEPT PMT-SCREEN-RECORD UNTIL
        F2-KEY, F3-KEY, F5-KEY, F7-KEY, F9-KEY.
*
    EVALUATE TRUE
        WHEN F2-KEY
            PERFORM PMT-PAYEE-LOOKUP
*
        WHEN F3-KEY
            MOVE "EX" TO PMT-FUNCTION-CODE
*
        WHEN F5-KEY
            PERFORM PMT-VALIDATE-PAYMENT
            IF PMT-MESSAGE-AREA = SPACES
                PERFORM PMT-CHECK-DUPLICATE
                IF PMT-DUP-CHECK-FLAG = "N"
                   OR PMT-DUP-OVERRIDE = "Y"
                    PERFORM PMT-SUBMIT-PAYMENT
                END-IF
            END-IF
*
        WHEN F7-KEY
            PERFORM PMT-FEE-SCHEDULE-LOOKUP
*
        WHEN F9-KEY
            MOVE "HI" TO PMT-FUNCTION-CODE
            SEND PMT-SCREEN-RECORD TO PMTSRV
                REPLY LENGTH 4096
                TIMEOUT 15
            IF TERMINATION-STATUS = 0
                RECEIVE PMT-SCREEN-RECORD FROM PMTSRV
                ESCAPE TO PMTHIST
            END-IF
*
    END-EVALUATE.
*
END PROCEDURE.
*
*================================================================
*  PAYEE LOOKUP
*================================================================
*
PROCEDURE PMT-PAYEE-LOOKUP.
*
    IF PMT-PAYEE-TYPE = SPACES
        MOVE "Enter payee type before lookup" TO PMT-MESSAGE-AREA
        DISPLAY OVERLAY PMT-MESSAGE-AREA
    ELSE
        MOVE "PL" TO PMT-FUNCTION-CODE
        SEND PMT-SCREEN-RECORD TO PMTSRV
            REPLY LENGTH 4096
            TIMEOUT 15
        IF TERMINATION-STATUS = 0
            RECEIVE PMT-SCREEN-RECORD FROM PMTSRV
            ESCAPE TO PAYLKUP
        ELSE
            MOVE "ERROR: Payee lookup unavailable"
                TO PMT-MESSAGE-AREA
            DISPLAY OVERLAY PMT-MESSAGE-AREA
        END-IF
    END-IF.
*
END PROCEDURE.
*
*================================================================
*  VALIDATE PAYMENT ENTRY
*================================================================
*
PROCEDURE PMT-VALIDATE-PAYMENT.
*
    MOVE SPACES TO PMT-MESSAGE-AREA.
*
*   Validate payment type
*
    IF PMT-TYPE-CODE NOT = "MD" AND PMT-TYPE-CODE NOT = "IN"
       AND PMT-TYPE-CODE NOT = "EX" AND PMT-TYPE-CODE NOT = "LG"
        MOVE "Invalid payment type code" TO PMT-MESSAGE-AREA
        DISPLAY OVERLAY PMT-MESSAGE-AREA
    END-IF.
*
*   Validate payee
*
    IF PMT-MESSAGE-AREA = SPACES
        IF PMT-PAYEE-ID = SPACES
            MOVE "Payee is required - use F2 for lookup"
                TO PMT-MESSAGE-AREA
            DISPLAY OVERLAY PMT-MESSAGE-AREA
        END-IF
    END-IF.
*
*   Validate amount
*
    IF PMT-MESSAGE-AREA = SPACES
        IF PMT-AMOUNT = ZERO OR PMT-AMOUNT < 0
            MOVE "Payment amount must be greater than zero"
                TO PMT-MESSAGE-AREA
            DISPLAY OVERLAY PMT-MESSAGE-AREA
        END-IF
    END-IF.
*
*   Validate indemnity period dates
*
    IF PMT-MESSAGE-AREA = SPACES
        IF PMT-TYPE-CODE = "IN"
            IF PMT-PERIOD-FROM = SPACES OR PMT-PERIOD-TO = SPACES
                MOVE "Period dates required for indemnity payments"
                    TO PMT-MESSAGE-AREA
                DISPLAY OVERLAY PMT-MESSAGE-AREA
            END-IF
        END-IF
    END-IF.
*
*   Validate EFT details if EFT method selected
*
    IF PMT-MESSAGE-AREA = SPACES
        IF PMT-METHOD-CODE = "EFT"
            IF PMT-EFT-ROUTING = SPACES OR PMT-EFT-ACCOUNT = SPACES
                MOVE "Routing and account required for EFT payments"
                    TO PMT-MESSAGE-AREA
                DISPLAY OVERLAY PMT-MESSAGE-AREA
            END-IF
        END-IF
    END-IF.
*
*   Validate CPT codes for medical payments
*
    IF PMT-MESSAGE-AREA = SPACES
        IF PMT-TYPE-CODE = "MD"
            IF PMT-SVC-CPT-1 = SPACES
                MOVE "At least one CPT/procedure code required"
                    TO PMT-MESSAGE-AREA
                DISPLAY OVERLAY PMT-MESSAGE-AREA
            END-IF
        END-IF
    END-IF.
*
*   Server-side validation (reserve adequacy, auth check, lien hold)
*
    IF PMT-MESSAGE-AREA = SPACES
        MOVE "VL" TO PMT-FUNCTION-CODE
        SEND PMT-SCREEN-RECORD TO PMTSRV
            REPLY LENGTH 4096
            TIMEOUT 15
        IF TERMINATION-STATUS = 0
            RECEIVE PMT-SCREEN-RECORD FROM PMTSRV
            IF PMT-RESERVE-ADEQUATE = "N"
                MOVE "WARNING: Payment exceeds outstanding reserve"
                    TO PMT-MESSAGE-AREA
                DISPLAY OVERLAY PMT-MESSAGE-AREA
            END-IF
            IF PMT-LIEN-HOLD-FLAG = "Y"
                MOVE "HOLD: Active lien on this claim - payment blocked"
                    TO PMT-MESSAGE-AREA
                DISPLAY OVERLAY PMT-MESSAGE-AREA
            END-IF
        END-IF
    END-IF.
*
END PROCEDURE.
*
*================================================================
*  CHECK FOR DUPLICATE PAYMENT
*================================================================
*
PROCEDURE PMT-CHECK-DUPLICATE.
*
    MOVE "DC" TO PMT-FUNCTION-CODE.
    MOVE "N" TO PMT-DUP-CHECK-FLAG.
*
    SEND PMT-SCREEN-RECORD TO PMTSRV
        REPLY LENGTH 4096
        TIMEOUT 15.
*
    IF TERMINATION-STATUS = 0
        RECEIVE PMT-SCREEN-RECORD FROM PMTSRV
        DISPLAY OVERLAY PMT-SCREEN-RECORD
        IF PMT-DUP-CHECK-FLAG = "Y"
            MOVE "DUPLICATE: Similar payment found - "
              &  "Enter Y to override"
                TO PMT-DUP-WARNING
            DISPLAY OVERLAY PMT-DUP-WARNING
        END-IF
    END-IF.
*
END PROCEDURE.
*
*================================================================
*  SUBMIT PAYMENT FOR PROCESSING
*================================================================
*
PROCEDURE PMT-SUBMIT-PAYMENT.
*
    MOVE "SB" TO PMT-FUNCTION-CODE.
*
    SEND PMT-SCREEN-RECORD TO PMTSRV
        REPLY LENGTH 4096
        TIMEOUT 60.
*
    IF TERMINATION-STATUS = 0
        RECEIVE PMT-SCREEN-RECORD FROM PMTSRV
        DISPLAY OVERLAY PMT-SCREEN-RECORD
        IF PMT-CHECK-NUMBER NOT = SPACES
            STRING "Payment submitted - Check/Ref# "
                   PMT-CHECK-NUMBER DELIMITED SPACES
                   INTO PMT-MESSAGE-AREA
        ELSE
            MOVE "Payment submitted for processing"
                TO PMT-MESSAGE-AREA
        END-IF
        MOVE SPACES TO PMT-DUP-WARNING
        DISPLAY OVERLAY PMT-DUP-WARNING
    ELSE
        MOVE "ERROR: Payment submission failed - try again"
            TO PMT-MESSAGE-AREA
    END-IF.
*
    DISPLAY OVERLAY PMT-MESSAGE-AREA.
*
END PROCEDURE.
*
*================================================================
*  FEE SCHEDULE LOOKUP
*================================================================
*
PROCEDURE PMT-FEE-SCHEDULE-LOOKUP.
*
    IF PMT-TYPE-CODE NOT = "MD"
        MOVE "Fee schedule lookup only for medical payments"
            TO PMT-MESSAGE-AREA
        DISPLAY OVERLAY PMT-MESSAGE-AREA
    ELSE
        MOVE "FS" TO PMT-FUNCTION-CODE
        SEND PMT-SCREEN-RECORD TO PMTSRV
            REPLY LENGTH 4096
            TIMEOUT 15
        IF TERMINATION-STATUS = 0
            RECEIVE PMT-SCREEN-RECORD FROM PMTSRV
            DISPLAY OVERLAY PMT-SCREEN-RECORD
            MOVE "Fee schedule amounts applied" TO PMT-MESSAGE-AREA
            DISPLAY OVERLAY PMT-MESSAGE-AREA
        END-IF
    END-IF.
*
END PROCEDURE.
*
*================================================================
*  TERMINATE SCREEN
*================================================================
*
PROCEDURE PMT-TERMINATE.
*
    ESCAPE TO CLMMENU.
*
END PROCEDURE.
